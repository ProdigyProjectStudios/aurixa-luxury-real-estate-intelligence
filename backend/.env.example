# ── Server ────────────────────────────────────────────────
HOST=0.0.0.0
PORT=1337

# ── Strapi security keys (generate your own random values) ─
# e.g. `openssl rand -base64 32` for each
APP_KEYS="key1,key2"
API_TOKEN_SALT=changeMe
ADMIN_JWT_SECRET=changeMe
TRANSFER_TOKEN_SALT=changeMe
JWT_SECRET=changeMe
ENCRYPTION_KEY=changeMe

# ── Database ──────────────────────────────────────────────
# postgres (recommended) or sqlite for local experimentation
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=aurixa
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=changeMe
DATABASE_SSL=false
# Alternatively, a single connection string:
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# Optional SSL tuning:
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_SSL_CA=
# DATABASE_SCHEMA=public
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10
# Used only when DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# ── Deployment host (Render) ──────────────────────────────
# Public origin used to resolve relative image URLs for AI analysis.
# If unset, code falls back to the staging host.
RENDER_EXTERNAL_URL=

# ── Media storage (Cloudinary) ────────────────────────────
CLOUDINARY_NAME=yourCloudName
CLOUDINARY_KEY=yourApiKey
CLOUDINARY_SECRET=yourApiSecret

# ── AI services ───────────────────────────────────────────
# Restb.ai computer-vision analysis of property photos (optional —
# enrichment is skipped when unset)
RESTB_API_KEY=

# OpenAI listing-description generation (optional — skipped when unset)
OPENAI_API_KEY=

# ── Lead handoff ──────────────────────────────────────────
# n8n webhook that receives inquiry payloads (optional — inquiries are
# stored with status payload_ready_no_webhook_configured when unset)
N8N_WEBHOOK_URL=

# ── Development-only convenience (never set in production) ─
# When NODE_ENV=development, bootstrap creates an admin user with these
# credentials if none exists.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
