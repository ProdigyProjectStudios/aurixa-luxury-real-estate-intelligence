# ── Dev server ────────────────────────────────────────────────────────────────
# Port the Vite dev server listens on. Defaults to 5173 if not set.
PORT=5173

# URL path prefix the app is served under (e.g. / for root, /aurixa/ for sub-path).
# Defaults to / if not set.
BASE_PATH=/

# ── Notes ─────────────────────────────────────────────────────────────────────
# This is a frontend-only SPA. There are no backend secrets required to run it.
# The production backend (listings API, AI intelligence layer) is hosted
# separately on Render and is not included in this repository.
